{
  "name": "kamysoft-erp-backend",
  "version": "1.0.0",
  "description": "KamySoft ERP & POS Full Stack Node/Express Backend Server",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build-frontend": "cd frontend && npm install && npm run build",
    "build-desktop": "npm run build-frontend && electron-builder --win"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@axenda/zatca": "^1.0.4",
    "@peculiar/webcrypto": "^1.7.1",
    "@peculiar/x509": "^2.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@talha7k/zatca": "^0.11.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jsrsasign": "^11.1.3",
    "mongoose": "^8.4.1",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "node-forge": "^1.4.0",
    "node-thermal-printer": "^4.6.0",
    "nodemailer": "^9.0.3",
    "puppeteer": "^25.3.0",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "electron": "31.3.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.2"
  },
  "build": {
    "appId": "com.kamysoft.erp",
    "productName": "26i ERP",
    "compression": "store",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "server.js",
      "models/**/*",
      "routes/**/*",
      "controllers/**/*",
      "utils/**/*",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/build/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "mongodb-bin",
        "to": "mongodb-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
